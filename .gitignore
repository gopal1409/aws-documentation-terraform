# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Terraform working directory
.terraform/

# Terraform state (state may contain sensitive information)
*.tfstate
*.tfstate.*

# Terraform variable files - keep examples such as *.tfvars.example tracked
*.tfvars
*.tfvars.json

# Terraform plan output
*.tfplan
plan.out

# Terraform crash logs
crash.log
crash.*.log

# Sensitive/local credentials and keys
*.pem
*.key
.aws/
credentials

# Local environment files
.env
.env.*
!.env.example

# Optional local course scratch directories
/ADDITIONAL-TOPICS
/FUTURE-TOPICS
